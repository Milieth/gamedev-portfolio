---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Separator from "@/components/bearnie/separator/Separator.astro";
import Card from "@/components/bearnie/card/Card.astro"
import CardContent from "@/components/bearnie/card/CardContent.astro";
import CardHeader from "@/components/bearnie/card/CardHeader.astro";
import CardTitle from "@/components/bearnie/card/CardTitle.astro";

interface Props {
  title?: string;
  author_notes?: string;
  use_back_navigation?: boolean;
  use_alltags_navigation?: boolean;
}

// get the given params, e.g: title="any title"
const { 
  title = "Milieth's Article",
  author_notes = "",
  use_back_navigation = true,
  use_alltags_navigation = true,
} = Astro.props;
---

<BaseLayout title={title}>
  <div class="flex w-full justify-center mt-8">
    <Card class="w-[800px]">
      <CardHeader>
          <CardTitle class="text-4xl text-center">{title}</CardTitle>
      </CardHeader>
      <Separator class="bg-zinc-400" />
      <CardContent class="mt-2 space-y-4">
        <p class="text-sm text-gray-400 block mt-1"><em>{author_notes}</em></p>
        <article>
          <slot />

          {use_back_navigation && (
            <div class="mt-8 pt-4 border-t border-gray-700">
              <a href="/gamedev-portfolio/blog/" class="inline-flex items-center text-blue-500 hover:text-blue-400 font-medium">
                ← Lihat semua artikel
              </a>
            </div>

          )}
          {use_alltags_navigation && (
            <a href="/gamedev-portfolio/tags/" class="inline-flex items-center text-blue-500 hover:text-blue-400 font-medium">
              ← Lihat semua tag
            </a>
          )}
        </article>
      </CardContent>
    </Card>
  </div>
</BaseLayout>
