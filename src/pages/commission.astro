---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Separator from "@/components/bearnie/separator/Separator.astro";
import Card from "@/components/bearnie/card/Card.astro"
import CardContent from "@/components/bearnie/card/CardContent.astro";
import CardHeader from "@/components/bearnie/card/CardHeader.astro";
import CardTitle from "@/components/bearnie/card/CardTitle.astro";

const isOpen = true;
---

<BaseLayout title="Milieth's Commission Page">
    <div class="flex w-full justify-center">
        {isOpen ? (
            <span class="px-3 py-1 rounded-full backdrop-blur-md border border-white/10 text-2xl font-semibold text-yellow-300 bg-green-600/60">
                Commission Status: Open \(^_^)/
            </span>
        ) : (
            <span class="px-3 py-1 rounded-full backdrop-blur-md border border-white/10 text-2xl font-semibold text-yellow-300 bg-red-600/60">
                Commission Status: Closed
            </span>
        )}
    </div>
    <div class="flex w-full justify-center mt-8">
        <Card class="w-[800px]">
            <CardHeader>
                <CardTitle class="text-4xl text-center">VN Development Service</CardTitle>
            </CardHeader>
            <Separator class="bg-zinc-400" />
            <CardContent class="mt-2 space-y-6">
                <!-- Intro Paragraph -->
                <p class="text-gray-300 leading-relaxed">
                    VN or Visual Novel is a narrative-driven video game that combines text-based storytelling with visual assets, background music, character sprites, and sound effects.
                </p>

                <!-- Showcase Image -->
                <figure class="space-y-2">
                    <img src="/gamedev-portfolio/games-ss/example.png" alt="VN UI Example" class="w-full rounded-lg border border-zinc-700" />
                    <figcaption class="text-gray-400 text-xs text-center italic">
                        Image source: Masteria Land Prologue
                    </figcaption>
                </figure>

                <!-- Section: Game Engine -->
                <div class="space-y-4">
                    <div class="space-y-1">
                        <Separator class="bg-zinc-400" />
                        <h2 class="text-2xl text-center font-bold">Game Engine</h2>
                        <Separator class="bg-zinc-400" />
                    </div>
                    
                    <div class="flex items-center justify-center gap-3 py-2">
                        <img src="/gamedev-portfolio/icons/renpy.png" alt="Ren'Py Logo" class="w-12 h-12" />
                        <span class="text-xl font-semibold">Ren'Py</span>
                    </div>
                </div>

                <!-- Section: Services Offered -->
                <div class="space-y-4">
                    <div class="space-y-1">
                        <Separator class="bg-zinc-400" />
                        <h2 class="text-2xl text-center font-bold">Services Offered</h2>
                        <Separator class="bg-zinc-400" />
                    </div>
                    
                    <ul class="list-disc list-outside ml-6 marker:text-xl marker:text-yellow-300 space-y-6 pt-2">
                        <li>
                            <span class="block text-lg font-bold text-emerald-400">Staging and Script Implementation</span>
                            <p class="text-gray-400 text-sm mt-1 mb-2">Implementing story scripts into Ren'Py script and adding VFX, SFX, BGM, etc., as requested.</p>
                            <div class="text-sm space-y-0.5">
                                <p class="text-white">Price: <strong>$15</strong> / 1,000 words</p>
                                <p class="text-white">Turnaround Time: 1–2 days per 5,000 words</p>
                            </div>
                        </li>

                        <li>
                            <span class="block text-lg font-bold text-emerald-400">GUI Implementation</span>
                            <p class="text-gray-400 text-sm mt-1 mb-2">Coding custom GUIs based on provided design mockups.</p>
                            <div class="text-sm space-y-0.5">
                                <p class="text-white">Price: Starting at <strong>$180</strong> (depends on complexity)</p>
                                <p class="text-white">Turnaround Time: 6 days</p>
                            </div>
                        </li>

                        <li>
                            <span class="block text-lg font-bold text-emerald-400">Feature or Minigame Development</span>
                            <p class="text-gray-400 text-sm mt-1 mb-2">Adding custom features or minigames to your game.</p>
                            <div class="text-sm space-y-0.5">
                                <p class="text-white">Price: Starting at <strong>$90</strong> (depends on complexity)</p>
                                <p class="text-white">Turnaround Time: 3–6 days</p>
                            </div>
                        </li>
                    </ul>
                </div>      

                <!-- Section: I Won't Accept -->
                <div class="space-y-4">
                    <div class="space-y-1">
                        <Separator class="bg-zinc-400" />
                        <h2 class="text-2xl text-center font-bold text-red-400">I Won't Accept</h2>
                        <Separator class="bg-zinc-400" />
                    </div>
                    
                    <div class="text-center py-2">
                        <ul class="inline-block text-left list-disc list-inside space-y-2">
                            <li class="text-gray-300">NSFW Projects</li>
                        </ul>
                    </div>
                </div>
            </CardContent>
        </Card>
    </div>
    <div class="flex w-full justify-center mt-8">
        <Card class="w-[800px] text-white">
            <CardHeader>
                <CardTitle class="text-4xl text-center font-extrabold tracking-tight">Payment</CardTitle>
            </CardHeader>
            <Separator class="bg-zinc-400" />
            <CardContent class="pt-6">

                    <div class="flex items-center gap-3 mb-2">
                        <span class="h-2 w-2 rounded-full bg-yellow-300"></span>
                        <h3 class="text-xl font-bold text-white">Payment Platform</h3>
                    </div>
                        <div>
                            <img src="/gamedev-portfolio/icons/paypal.svg" 
                            alt="Paypal Icon SVG" 
                            class="w-30 h-30 block ml-4 -my-10"/>
                            <!-- <p class="text-zinc-500 text-xs uppercase tracking-wider font-semibold">Paypal</p> -->
                        </div>
                    <br>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="h-2 w-2 rounded-full bg-yellow-300"></span>
                        <h3 class="text-xl font-bold text-white">Payment Methods</h3>
                    </div>
                    <div class="ml-5 space-y-3">                        
                        <div>
                            <p class="text-gray-200">You may select one of the following payment methods:</p>
                            <ul class="list-disc list-outside ml-5 space-y-2 marker:text-white">
                                <li class="text-gray-400 text-sm">
                                    <strong class="text-gray-200">50% Upfront:</strong> 50% deposit before work begins, remaining 50% upon final completion.
                                </li>
                                <li class="text-gray-400 text-sm space-y-2">
                                <p><strong class="text-gray-200">Milestone Based:</strong> The project is divided into stages.</p>
                                
                                <ul class="ml-4 mt-2 space-y-1 font-mono text-sm">
                                    <p><strong class="text-gray-400">The process works as follows:</p>
                                    <li class="flex items-center gap-2">
                                    <span class="text-indigo-400 font-bold">Phase 1:</span> Pay <span class="text-gray-500">&rarr;</span> Complete
                                    </li>
                                    <li class="flex items-center gap-2">
                                    <span class="text-indigo-400 font-bold">Phase 2:</span> Pay <span class="text-gray-500">&rarr;</span> Complete
                                    </li>
                                    <li class="text-gray-500 italic">Repeat until the project is finished.</li>
                                </ul>
                                </li>                            
                            </ul>
                        </div>
                    </div>
                </ul>
            </CardContent>
        </Card>
    </div>
    <div class="flex w-full justify-center mt-8">
        <Card class="w-[800px]">
        <CardHeader>
            <CardTitle class="text-4xl text-center">Warranty Period</CardTitle>
        </CardHeader>
        <Separator class="bg-zinc-400" />
        <CardContent class="mt-2">
            <p class="text-gray-200 text-sm">Following final delivery, there is a <strong>7-day warranty period</strong>.</p>
            <p class="text-gray-400 text-sm"><strong>Included:</strong> Fixes for bugs found within the delivered scope.</p>
            <p class="text-gray-400 text-sm"><strong>Excluded:</strong> New features or unrelated code changes.</p>
        </CardContent>
        </Card>
    </div>
    <div class="flex w-full justify-center mt-8">
        <Card class="w-[800px]">
            <CardHeader>
                <CardTitle class="text-4xl text-center">Confidentiality and Security</CardTitle>
            </CardHeader>
            <Separator class="bg-zinc-400" />
            <CardContent class="mt-2">
                <p class="text-gray-200 text-sm">The commissioner(me) commits to maintaining the highest level of confidentiality. Any source code, project designs, or 
                    proprietary information shared by the client will be used solely for the fulfillment of the commission and will not be 
                    shared with third parties.</p>
            </CardContent>
            <!-- <Separator class="bg-zinc-400" />
            <CardContent class="mt-4">
                <h class="text-lg"1>About Waranty Period</h1>
                <p class="text-gray-400 text-sm">Following the final delivery there is waranty period for 7 days.</p>
                <p class="text-gray-400 text-sm"><strong>Included:</strong> Fixes for bugs found in the delivered scope.</p>
                <p class="text-gray-400 text-sm"><strong>Excluded:</strong> New features or unrelated code changes.</p>
            </CardContent> -->
        </Card>
    </div>
</BaseLayout>