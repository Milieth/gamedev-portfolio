---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';

// 1. Dapatkan semua rute tag yang valid saat build
export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // Mengambil seluruh tag unik dari semua artikel
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

  // Membuat halaman untuk setiap tag dan memfilter postingan yang sesuai
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

// 2. Ambil parameter URL dan data postingan yang sudah difilter
const { tag } = Astro.params;
const { posts } = Astro.props;
const title = `Artikel Tag: #${tag}`;
---

<ArticleLayout title={title} use_back_navigation={true} use_alltags_navigation={true}>
  <h1 class="text-xl">Hasil Filter Tag: #{tag}</h1>
  <p class="mt-2 mb-2">Menampilkan {posts.length} artikel</p>

  <ul class="list-disc list-outside ml-6 marker:text-xl marker:text-yellow-300 space-y-6 pt-2">
    {posts.map((post) => (
      <li>
        <a href={`/gamedev-portfolio/blog/${post.slug}/`}
           class="text-blue-500 underline hover:text-blue-400 font-semibold">
          <h2>{post.data.title}</h2>
        </a>

        <p>{post.data.description}</p>

        <time class="text-xs text-gray-400 block mt-1">
          {post.data.pubDate.toLocaleDateString('id-ID')}
        </time>
      </li>
    ))}
  </ul>

</ArticleLayout>