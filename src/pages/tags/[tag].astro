---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';

// generate tag page for each unique tag found in .md file 
// the tag page include filetered post (post with that tags)
export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  // get all unique tags found in all post
  // the result is in array format e.g: ['javascript', 'astro', 'react']
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

  return uniqueTags.map((tag) => {
    // filter the post by each tag and sort it in descending order from newest to oldest
    const filteredPosts = allPosts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    // determine url tag (the params keyword). and passing Astro.props
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

// get current target tag and filtered post associated witht that tag
const { tag } = Astro.params;
const { posts } = Astro.props;
// create dynamic title for each tag
const title = `Artikel Tag: #${tag}`;
---

<ArticleLayout title={title} use_back_navigation={true} use_alltags_navigation={true}>
  <h1 class="text-xl">Hasil Filter Tag: #{tag}</h1>
  <p class="mt-2 mb-2">Menampilkan {posts.length} artikel</p>

  <ul class="list-disc list-outside ml-6 marker:text-xl marker:text-yellow-300 space-y-6 pt-2">
    {posts.map((post) => (
      <li>
        <a href={`/gamedev-portfolio/blog/${post.slug}/`}
           class="text-blue-500 underline hover:text-blue-400 font-semibold">
          <h2>{post.data.title}</h2>
        </a>

        <p>{post.data.description}</p>

        <time class="text-xs text-gray-400 block mt-1">
          {post.data.pubDate.toLocaleDateString('id-ID')}
        </time>
      </li>
    ))}
  </ul>

</ArticleLayout>