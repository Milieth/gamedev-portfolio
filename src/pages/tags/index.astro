---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// 1. Ambil seluruh tag unik dari semua artikel
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

// 2. Hitung berapa banyak artikel di masing-masing tag
const tagCounts = tags.reduce((acc, tag) => {
  acc[tag] = allPosts.filter((post) => post.data.tags.includes(tag)).length;
  return acc;
}, {} as Record<string, number>);
---

<ArticleLayout title="Artikel Tags" use_alltags_navigation={false}>
  <h1>Eksplorasi Berdasarkan Tag</h1>
  <p>Ditemukan total {tags.length} topik pembahasan.</p>

  <div class="tag-cloud flex flex-wrap gap-2.5 my-4">
    {tags.map((tag) => (
      <a 
        href={`${import.meta.env.BASE_URL}/tags/${tag}`} 
        class="tag-item text-blue-300 hover:text-white bg-blue-950/60 hover:bg-blue-600 border border-blue-800/80 hover:border-blue-500 px-3 py-1.5 rounded-lg text-sm font-medium transition-all"
      >
        #{tag} <span class="text-blue-400/80 text-xs ml-1 font-semibold">({tagCounts[tag]})</span>
      </a>
    ))}
  </div>
</ArticleLayout>