---
import { getCollection } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';

// 1. Ambil semua path yang akan di-generate saat build
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// 2. Ambil data entri dan render isi markdown
const { entry } = Astro.props;
const { Content } = await entry.render();
const author_notes = `Ditulis oleh ${entry.data.author} pada ${entry.data.pubDate.toLocaleDateString('id-ID')}`;
---

<ArticleLayout author_notes={author_notes} title={entry.data.title}>
  <!-- Render konten markdown -->
  <div class="prose prose-invert max-w-none">
    <Content />
  </div>  


  <!-- Tag artikel -->
  <div class="tag-cloud flex flex-wrap gap-2.5 my-4">
    {entry.data.tags.map((tag) => (
      <a 
        href={`/gamedev-portfolio/tags/${tag}`}
        class="tag-item text-blue-300 hover:text-white bg-blue-950/60 hover:bg-blue-600 border border-blue-800/80 hover:border-blue-500 px-3 py-1.5 rounded-lg text-sm font-medium transition-all"
      >
        #{tag}
      </a>
    ))}
  </div>
  
</ArticleLayout>