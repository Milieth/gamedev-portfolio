---
import { getCollection } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';

// 1. Ambil semua path yang akan di-generate saat build
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// 2. Ambil data entri dan render isi markdown
const { entry } = Astro.props;
const { Content } = await entry.render();
const author_notes = `Ditulis oleh ${entry.data.author} pada ${entry.data.pubDate.toLocaleDateString('id-ID')}`;
---

<ArticleLayout author_notes={author_notes} title={entry.data.title}>
  <!-- Render konten markdown -->
  <div class="prose prose-invert max-w-none">
    <Content />
  </div>  

  <!-- Tag artikel -->
  <div class="flex flex-wrap gap-2 my-4">
    {entry.data.tags.map((tag) => (
      <a 
        href={`/gamedev-portfolio/tags/${tag}`}
        class="text-blue-600 hover:text-blue-800 hover:underline px-2.5 py-1 bg-blue-50 hover:bg-blue-100 rounded-md text-sm font-medium transition-colors"
      >
        #{tag}
      </a>
    ))}
  </div>
  
</ArticleLayout>