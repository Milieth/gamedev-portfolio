---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';

// Mengambil seluruh file dari folder src/content/blog/
const allPosts = await getCollection('blog');

// Mengurutkan postingan dari yang terbaru
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<ArticleLayout title="Welcome to My Blog">
  <h1 class="text-2xl text-emerald-400 font-bold">Daftar Artikel</h1>

  <ul class="list-disc list-outside ml-6 marker:text-xl marker:text-yellow-300 space-y-6 pt-2">
    {posts.map((post) => (
      <li>
        <a href={`/gamedev-portfolio/blog/${post.slug}/`}>
          <h2>{post.data.title}</h2>
        </a>
        <p>{post.data.description}</p>
        <time>{post.data.pubDate.toLocaleDateString('id-ID')}</time>
      </li>
    ))}
  </ul>
</ArticleLayout>